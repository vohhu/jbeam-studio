  {
   "section": "nodes",
   "key": "impactPlasticEvent",
   "description": "Overrides the node's plastic impact sound event",
   "type": "string",
   "default": "",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/nodes/#args_impactPlasticEvent"
  },
  {
   "section": "nodes",
   "key": "fixed",
