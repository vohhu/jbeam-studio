   "type": "number",
   "default": "frictionCoef",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/nodes/#args_slidingFrictionCoef"
  },
  {
   "section": "nodes",
   "key": "nodeMaterial",
   "description": "Physics material of the node, rubber, metal, etc.",
   "type": "string",
   "default": "options.nodeMaterial",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/nodes/#args_nodeMaterial"
  },
  {
