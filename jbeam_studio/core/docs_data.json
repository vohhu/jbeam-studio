  {
   "section": "nodes",
   "key": "id",
   "description": "Defines the node name. **Need to be unique** for the whole vehicle",
   "type": "string",
   "default": "",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/nodes/#args_id"
  },
  {
   "section": "nodes",
   "key": "posX",
   "description": "The X (left/right) position in 3D space. Left is positive, right is negative",
   "type": "number",
   "default": "",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/nodes/#args_posX"
  },
  {
   "section": "nodes",
   "key": "posY",
   "description": "The Y (forward/back) position in 3D space. Backward is positive, forward is negative",
   "type": "number",
   "default": "",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/nodes/#args_posY"
  },
  {
   "section": "nodes",
   "key": "posZ",
   "description": "The Z (up/down) position in 3D space. Up is positive, down is negative",
   "type": "number",
   "default": "",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/nodes/#args_posZ"
  },
  {
   "section": "nodes",
   "key": "nodeWeight",
   "description": "The weight of the node in kg",
   "type": "number",
   "default": "options.nodeWeight",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/nodes/#args_nodeWeight"
  },
  {
   "section": "nodes",
   "key": "collision",
