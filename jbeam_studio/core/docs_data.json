   "default": "false",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/nodes/#args_selfCollision"
  },
  {
   "section": "nodes",
   "key": "staticCollision",
   "description": "If the node can collide with map objects and terrain. True by default",
   "type": "boolean",
   "default": "true",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/nodes/#args_staticCollision"
  },
  {
   "section": "nodes",
   "key": "group",
   "description": "Groups a set of nodes into a group that can be used later in other sections",
   "type": "string",
   "default": "",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/nodes/#args_group"
  },
  {
   "section": "nodes",
   "key": "engineGroup",
   "description": "A different kind of group, related to powertrain simulation",
   "type": "string",
   "default": "",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/nodes/#args_engineGroup"
  },
  {
   "section": "nodes",
   "key": "frictionCoef",
   "description": "Static friction of the node. Default is 1",
   "type": "number",
   "default": "1",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/nodes/#args_frictionCoef"
  },
  {
   "section": "nodes",
   "key": "slidingFrictionCoef",
