   "default": "",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/nodes/#args_pairedNode"
  },
  {
   "section": "slotType",
   "key": "",
   "description": "The slot type of this part. It decides into which slots the part fits. Can also be a list of slot types",
   "type": "string",
   "default": "",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/slots/"
  },
  {
   "section": "slots2",
   "key": "name",
   "description": "The name of the slot. **Need to be unique** inside the part. Part config (PC) files reference this name",
   "type": "string",
   "default": "",
   "url": "https://documentation.beamng.com/modding/vehicle/sections/slots/"
  },
  {
   "section": "slots2",
   "key": "allowTypes",
